---
import { siteConfig } from "@/config";

// 检查页面是否启用
if (!siteConfig.pages.sponsor) {
	return Astro.redirect("/404/");
}

return Astro.redirect("https://www.antwen.cn/sponsor");
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content="0; url=https://www.antwen.cn/sponsor" />
  <link rel="canonical" href="https://www.antwen.cn/sponsor" />
  <title>正在跳转至赞助支持页面...</title>
  <script is:inline>
    window.location.replace("https://www.antwen.cn/sponsor");
  </script>
</head>
<body>
  <p>正在跳转至 <a href="https://www.antwen.cn/sponsor">赞助支持页面</a>...</p>
</body>
</html>
